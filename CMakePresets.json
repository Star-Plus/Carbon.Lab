{
    "version": 6,
    "configurePresets": [
        {
            "name": "mingw",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "mingw-release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "MSVC - Debug",
            "description": "Using MSVC compiler with Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "v143",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "MSVC - Release",
            "description": "Using MSVC compiler with Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "windows-cross-release",
            "displayName": "Windows Cross-Compile - Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Native Release (GCC)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-debug",
            "displayName": "Visual Studio Community 2022 Release - amd64 - Debug",
            "configurePreset": "msvc-debug",
            "configuration": "Debug"
        },
        {
            "name": "msvc-release",
            "displayName": "Visual Studio Community 2022 Release - amd64 - Release",
            "configurePreset": "msvc-release",
            "configuration": "Release",
            "jobs": 2
        },
        {
            "name": "mingw-debug",
            "displayName": "MinGW - Debug",
            "configurePreset": "mingw",
            "configuration": "Debug"
        },
        {
            "name": "mingw-release",
            "displayName": "MinGW - Release",
            "configurePreset": "mingw-release",
            "configuration": "Release",
            "jobs": 2
        },
        {
            "name": "windows-cross-release",
            "displayName": "Build Windows Cross-Compile - Release",
            "configurePreset": "windows-cross-release",
            "configuration": "Release",
            "jobs": 2
        },
        {
            "name": "linux-release",
            "displayName": "Linux Native Release (GCC)",
            "configurePreset": "linux-release",
            "configuration": "Release",
            "jobs": 2
        }
    ],
    "testPresets": [
        {
            "name": "msvc-debug",
            "displayName": "Run Tests - Debug",
            "configurePreset": "msvc-debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "ignore"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "Run Tests - Release",
            "configurePreset": "msvc-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "ignore"
            }
        },
        {
            "name": "mingw-debug",
            "displayName": "Run Tests - MinGW Debug",
            "configurePreset": "mingw",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "ignore"
            }
        },
        {
            "name": "mingw-release",
            "displayName": "Run Tests - MinGW Release",
            "configurePreset": "mingw",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "ignore"
            }
        }
    ]
}